# Set these in the process environment; the application does not auto-load .env.
# Use the actual model ID supported by your provider, not a marketing label.
ROBOFLEX_VLM_BASE_URL=https://your-provider.example/v1
ROBOFLEX_VLM_MODEL=your-vision-model-id
ROBOFLEX_VLM_API_KEY=replace-locally
# Required when the gateway listens outside loopback.
ROBOFLEX_ACCESS_TOKEN=replace-with-a-long-random-token
