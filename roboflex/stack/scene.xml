<mujoco model="RoboFlex reference mobile manipulator">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual><global offwidth="960" offheight="720"/><headlight ambient="0.5 0.5 0.5" diffuse="0.7 0.7 0.7"/></visual>
  <default><joint damping="1" armature=".01"/><geom friction="0.8 0.01 0.001" solref="0.01 1"/></default>
  <worldbody>
    <light pos="0.6 -0.5 3"/>
    <geom name="floor" type="plane" size="3 3 .1" rgba=".90 .93 .95 1"/>
    <camera name="overview" pos="1.9 -2.2 1.8" xyaxes=".77 .64 0 -.32 .39 .86"/>
    <geom name="obstacle" type="box" pos=".55 .18 .10" size=".07 .10 .10" rgba=".65 .70 .75 1"/>
    <geom name="tray_floor" type="box" pos="1.15 .55 .02" size=".16 .14 .02" rgba=".1 .6 .6 1"/>
