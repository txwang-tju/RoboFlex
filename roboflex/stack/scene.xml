    <body name="grasp_anchor" mocap="true" pos="0 0 1"><geom type="sphere" size=".004" contype="0" conaffinity="0" rgba="0 0 0 0"/></body>
  </worldbody>
  <equality><weld name="grasp_attachment_approximation" body1="grasp_anchor" body2="bottle" relpose="0 0 0 1 0 0 0" active="false" solref=".005 1"/></equality>
  <actuator>
    <position joint="base_x" kp="5000" kv="180"/>
    <position joint="base_y" kp="5000" kv="180"/>
    <position joint="base_yaw" kp="500" kv="40"/>
    <position joint="arm_yaw" kp="150" kv="12"/>
    <position joint="shoulder" kp="150" kv="12"/>
    <position joint="elbow" kp="150" kv="12"/>
